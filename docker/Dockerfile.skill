# =============================================================================
# Dockerfile.skill — Container hardened (Node 26 Alpine, non-root) para a skill
# =============================================================================

FROM node:26-alpine AS base

WORKDIR /app

COPY package.json pnpm-lock.yaml* ./

RUN npm install -g pnpm@10 && (pnpm install --frozen-lockfile || pnpm install)

COPY src ./src
COPY config ./config
COPY tsconfig.json ./

RUN pnpm build

# =============================================================================
# Runtime stage
# =============================================================================
FROM node:26-alpine AS runtime

RUN apk add --no-cache \
    ffmpeg \
    git \
    curl \
    jq \
    && rm -rf /var/cache/apk/*

WORKDIR /app

COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/dist ./dist
COPY --from=base /app/package.json ./
COPY --from=base /app/config ./config

RUN addgroup -g 1001 -S skilluser && \
    adduser -u 1001 -S skilluser -G skilluser && \
    mkdir -p /data/skill /data/comfyui/output /data/comfyui/input /data/ffmpeg/temp && \
    chown -R skilluser:skilluser /data

USER skilluser

ENV NODE_ENV=production \
    SKILL_DATA_PATH=/data/skill \
    COMFYUI_OUTPUT_PATH=/data/comfyui/output \
    COMFYUI_INPUT_PATH=/data/comfyui/input \
    FFMPEG_TEMP_PATH=/data/ffmpeg/temp

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD node -e "import('./dist/skill-entry.js').then(m => m.skill.execute({action:'get-status',params:{}})).then(r => process.exit(r.success ? 0 : 1)).catch(() => process.exit(1))"

ENTRYPOINT ["node", "dist/skill-entry.js"]
