# =============================================================================
# claude-skill-media-studio - Variáveis de Ambiente
# Copie para .env e ajuste conforme seu ambiente
# =============================================================================

# --- Paths no Host (devem existir - use scripts/setup-volumes.sh) ---
HOST_DATA_ROOT=/mnt/data
SKILL_DATA_PATH=/mnt/data/skill
COMFYUI_OUTPUT_PATH=/mnt/data/comfyui/output
COMFYUI_INPUT_PATH=/mnt/data/comfyui/input
FFMPEG_TEMP_PATH=/mnt/data/ffmpeg/temp

# --- ComfyUI ---
COMFYUI_ENDPOINT=http://localhost:8188
COMFYUI_HEALTH_PATH=/system_stats
COMFYUI_TIMEOUT_MS=300000
COMFYUI_MAX_CONCURRENT=2

# --- AssistentePessoal ---
ASSISTENTE_PESSOAL_BASE_URL=https://jarvis.laytech.com.br
ASSISTENTE_PESSOAL_API_KEY=your_api_key_here
ASSISTENTE_PESSOAL_TIMEOUT_MS=30000

# --- FFmpeg ---
FFMPEG_BINARY=ffmpeg
FFMPEG_PRESET=medium
FFMPEG_CRF=20

# --- Storage ---
STORAGE_MAX_FILE_SIZE=2147483648
STORAGE_CLEANUP_TEMP_HOURS=24

# --- Pipeline Defaults ---
DEFAULT_IMAGE_MODEL=sd_xl_base_1.0.safetensors
DEFAULT_VIDEO_MODEL=svd_xt_1_1.safetensors
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=1024
DEFAULT_VIDEO_WIDTH=1024
DEFAULT_VIDEO_HEIGHT=576
DEFAULT_FPS=8
DEFAULT_DURATION=4
DEFAULT_STEPS=25
DEFAULT_CFG=7
DEFAULT_SAMPLER=euler_ancestral
DEFAULT_SCHEDULER=normal

# --- Social ---
SOCIAL_DEFAULT_ASPECT_RATIO=9:16
SOCIAL_DEFAULT_RESOLUTION=1080x1920
SOCIAL_MAX_CAPTION_LENGTH=2200

# --- Discovery ---
DISCOVERY_SCAN_INTERVAL_MS=300000
DISCOVERY_HEALTH_CHECK_INTERVAL_MS=60000

# --- App ---
NODE_ENV=development
LOG_LEVEL=info
