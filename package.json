{
  "name": "claude-skill-media-studio",
  "version": "1.1.0",
  "description": "Claude Skill para geração de imagens/vídeos (ComfyUI) + montagem (FFmpeg) + publicação social (AssistentePessoal)",
  "type": "module",
  "main": "dist/skill-entry.js",
  "types": "dist/skill-entry.d.ts",
  "bin": {
    "claude-skill-media-studio": "dist/skill-entry.js",
    "media-studio-mcp": "dist/mcp-server.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/verissimodf/claude-skill-media-studio.git"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/skill-entry.ts",
    "start": "node dist/skill-entry.js",
    "mcp": "node dist/mcp-server.js",
    "install:clients": "node scripts/install-clients.mjs --client all",
    "install:claude": "node scripts/install-clients.mjs --client claude",
    "install:chatgpt": "node scripts/install-clients.mjs --client chatgpt",
    "install:opencode": "node scripts/install-clients.mjs --client opencode",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "security:audit": "pnpm audit --audit-level=high",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:live": "RUN_LIVE_GENERATION=true pnpm test:integration",
    "scan": "./scripts/host-scan.sh",
    "scan:json": "./scripts/host-scan.sh --json",
    "verify": "./scripts/verify-requirements.sh",
    "verify:models": "./scripts/verify-models.sh",
    "setup:volumes": "./scripts/setup-volumes.sh",
    "test:e2e": "./scripts/test-integration.sh",
    "docker:build": "docker build -f docker/Dockerfile.skill -t claude-skill-media-studio .",
    "docker:run": "docker compose -f docker/docker-compose.skill.yml up -d",
    "docker:logs": "docker compose -f docker/docker-compose.skill.yml logs -f",
    "docker:down": "docker compose -f docker/docker-compose.skill.yml down",
    "prepare": "husky || true"
  },
  "keywords": [
    "claude",
    "skill",
    "comfyui",
    "ffmpeg",
    "ai-generation",
    "video-generation",
    "image-generation",
    "social-media",
    "automation"
  ],
  "author": "verissimodf",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.6.2",
  "dependencies": {
    "axios": "^1.21.1",
    "form-data": "^4.0.6",
    "mime-types": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.11",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.2"
  }
}
